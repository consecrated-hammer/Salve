# CurseForge / WoWInterface packaging, for BigWigsMods/packager.
# The repo root IS the addon folder, so there is nothing to move-folders.

package-as: Salve

# No embedded libraries, so there is no no-lib variant worth building.
enable-nolib-creation: no

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

license-output: LICENSE.txt

ignore:
  - .github
  - .pkgmeta
  - .gitignore
  - Build-CurseForgeZip.local.ps1
  - Copy-ToWoWAddons.local.ps1
  # Source art for the CurseForge project icon, uploaded through their site.
  # The game cannot load a PNG, so shipping it would be dead weight in every
  # download. Textures/Salve.tga is the in-game version.
  - Textures/Salve.png
  - Textures/Salve-curseforge-400.png
