# CurseForge / WoWInterface packaging, for BigWigsMods/packager.
# The repo root IS the main addon folder; the companion below is moved out
# beside it so the package contains two addons.

package-as: Salve

# The companion ships alongside as its own addon folder, so a season's debuff
# list can be updated without touching Salve itself.
move-folders:
  Salve/Salve_SeasonData: Salve_SeasonData

# No embedded libraries, so there is no no-lib variant worth building.
enable-nolib-creation: no

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

license-output: LICENSE.txt

ignore:
  - .github
  - .pkgmeta
  - .gitignore
  - Build-CurseForgeZip.local.ps1
  - Copy-ToWoWAddons.local.ps1
  # Source art for the CurseForge project icon, uploaded through their site.
  # The game cannot load a PNG, so shipping it would be dead weight in every
  # download. Textures/Salve.tga is the in-game version.
  - Textures/Salve.png
  - Textures/Salve-curseforge-400.png
